{
  "name": "yapper",
  "version": "0.1.0",
  "type": "module",
  "description": "Privacy-first browser TTS — all inference runs locally via WebGPU",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/copy-pdf-worker.mjs && node scripts/copy-phonemizer.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:links": "YAPPER_LINK_CHECK=1 vitest run src/links.test.ts",
    "demo:capture": "python3 scripts/capture_demo.py",
    "icons:build": "node scripts/build-icons.cjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "epubjs": "^0.3.93",
    "fflate": "^0.8.3",
    "jszip": "^3.10.1",
    "kokoro-js": "^1.2.1",
    "onnxruntime-web": "^1.26.0",
    "pdfjs-dist": "^6.1.200",
    "phonemizer": "^1.2.1",
    "tesseract.js": "^7.0.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.8",
    "protobufjs": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.0.0",
    "jsdom": "^30.0.0",
    "playwright": "^1.62.0",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
