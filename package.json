{
  "name": "yapper",
  "version": "0.1.0",
  "type": "module",
  "description": "Privacy-first browser TTS — all inference runs locally via WebGPU",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:links": "YAPPER_LINK_CHECK=1 vitest run src/links.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "epubjs": "^0.3.93",
    "fflate": "^0.8.3",
    "jszip": "^3.10.1",
    "kokoro-js": "^1.2.1",
    "mammoth": "^1.12.0",
    "onnxruntime-web": "^1.26.0",
    "pdfjs-dist": "^6.1.200",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@vitest/ui": "^4.1.10",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
