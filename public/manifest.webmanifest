{
  "name": "Yapper — Private Text-to-Speech",
  "short_name": "Yapper",
  "description": "Browser TTS with zero cloud. Kokoro, Kitten, SpeechT5 — 9 languages, runs offline once loaded.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
